# Flask / GitHub Gist integration (optional)
# GIST_TOKEN=
# GIST_ID=
# GIT_COMMANDS_FILE=git_commands.md
# INSIGHTS_FILE=Insights.md

# Market data provider: KIS OpenAPI
KIS_ENV=demo
# demo(모의): https://openapivts.koreainvestment.com:29443
# real(실전): https://openapi.koreainvestment.com:9443
# KIS_BASE_URL=

# 아래 값은 KIS Developers에서 발급받은 APP KEY/SECRET를 입력하세요.
KIS_APP_KEY=
KIS_APP_SECRET=

# Debug / throttling (optional)
KIS_API_DEBUG=false
# If you hit rate limits, set a small delay (seconds) between requests (e.g. 0.05)
KIS_REQUEST_DELAY_SEC=0

# Safety guard for OHLCV pagination loop (optional)
KIS_OHLCV_MAX_ITERS=50
